{
  "name": "exam-escape",
  "version": "1.0.0",
  "description": "Exam Escape - Subway Surfers style runner game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "cap:init": "npx cap init \"Exam Escape\" \"com.examescape.game\" --web-dir=www",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "better-sqlite3": "^11.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  }
}
